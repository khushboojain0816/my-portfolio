# Copy this file to .env.local and fill in real values.
# Get a free API key at https://resend.com after verifying a sending domain
# (or use the resend.dev test domain while developing).
RESEND_API_KEY=

# Optional overrides:
# CONTACT_FROM_EMAIL="Portfolio Contact Form <onboarding@resend.dev>"
# CONTACT_TO_EMAIL=khushboojain0816@gmail.com

# --- Supabase (projects data + admin portal) ---
# Create a free project at https://supabase.com, then run supabase/schema.sql
# in its SQL editor. Get these values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key (NOT the anon key). Keep this secret — never expose
# it to the browser or commit it. Used server-side only, by /admin routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin portal auth (/admin) ---
# Password you'll type in at /admin/login. Pick something strong.
ADMIN_PASSWORD=
# Random secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
